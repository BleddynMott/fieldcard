        "grid": 3,
        "startLength": 3,
        "maxLength": 9,
        "flashMsMonday": 520,
        "flashMsStepPerDay": -30,
        "gapMs": 160,
        "pauseBeforeMs": 700,
        "betweenRoundsMs": 700
