  "doors": {
    "stop": {
      "metric": "signedMean",
      "below": -2,
      "above": 2,
      "labels": [
        "Early",
        "On it",
        "Late"
      ],
      "facts": [
        "stopped early",
        "stopped on the notch",
        "stopped late"
      ],
      "ask": "Everyone had the same sweep you just had. Where did the biggest share stop: early, on the notch, or late?"
    },
    "count": {
      "metric": "signedError",
      "below": 0,
      "above": 0,
      "labels": [
        "Too few",
        "Spot on",
        "Too many"
      ],
      "facts": [
        "counted too few",
        "counted exactly right",
        "counted too many"
      ],
      "ask": "Everyone saw the same crowd you just counted. Did the biggest share say too few, spot on, or too many?"
    },
    "repeat": {
      "metric": "longest",
      "below": 5,
      "above": 6,
      "labels": [
        "Under 5",
        "5 or 6",
        "7 or more"
      ],
      "facts": [
        "repeated fewer than 5",
        "repeated 5 or 6",
        "repeated 7 or more"
      ],
      "ask": "Everyone had the same squares you just had. How far did the biggest share get?"
    },
    "pair": {
      "metric": "seconds",
      "below": 5,
      "above": 10,
      "labels": [
        "Under 5 s",
        "5 to 10 s",
        "Over 10 s"
      ],
      "facts": [
        "found the pair in under 5 seconds",
        "found it in 5 to 10 seconds",
        "took over 10 seconds"
      ],
      "ask": "Everyone had the same twelve shapes you just had. How long did the biggest share take?"
    },
    "sort": {
      "metric": "pairsOut",
      "below": 1,
      "above": 1,
      "labels": [
        "Perfect",
        "One pair out",
        "More"
      ],
      "facts": [
        "sorted them perfectly",
        "had one pair out",
        "had more than one pair out"
      ],
      "ask": "Everyone had the same five blobs you just had. How did the biggest share do?"
    }
  },
