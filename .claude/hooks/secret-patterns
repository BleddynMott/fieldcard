# Credential shapes shared by block-secrets.sh (PreToolUse) and pre-commit (index). [A6; §4.1 row 30; §4.5 operator-side rules]
# One rule per line: kind|extended-regex (grep -E, matched case-insensitively).
#   token  — blocks wherever it appears: commands, file content, the staged index.
#   label  — a credential label followed by a value; applied only to document-shaped
#            paths (docs/, *.md, *.html, *.txt, *.csv, *.rtf), the shape that leaked
#            in the D18 handout. Values matching the allowlist below are exempt.
#   pair   — an email address with a password label close by (a complete sign-in path);
#            document-shaped paths only.
# The label and pair rules are taken from rapid-triage's .gitleaks.toml; the token rules are new.
token|-----BEGIN [A-Z ]*PRIVATE KEY-----
token|sb_secret_[A-Za-z0-9_-]{10,}
token|AKIA[0-9A-Z]{16}
token|gh[pousr]_[A-Za-z0-9]{30,}
token|github_pat_[A-Za-z0-9_]{22,}
token|sk-ant-[A-Za-z0-9_-]{20,}
token|sk_live_[A-Za-z0-9]{16,}
token|sbp_[A-Za-z0-9]{20,}
token|postgres(ql)?://[^:/[:space:]]+:[^@/[:space:]]{4,}@
jwt|eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}
label|pass(word|code|phrase)\**[[:space:]]*(:|=|</[a-z]+>[[:space:]]*<[^>]*>)[[:space:]]*\**[[:space:]]*["'>]?[^[:space:]<>"'*]{4,}
pair|[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}.{0,160}pass(word|code)
# Allowlists (kind "allow-<rule>"): a match whose captured VALUE (label) or whole match (pair, token) matches one of these is not a finding.
allow-label|^(&nbsp;?|_{3,}|\.{3,}|-{3,}|x{3,}|\*{3,})$
allow-label|^(tbc|tbd|todo|redacted|placeholder|removed|see[-_]?below|ask[-_]?lead|string|str|text|boolean|number|required|optional)[;,.]?$
allow-label|^(\$|\{\{|<|\[|process\.env|os\.environ|import\.meta\.env|env\(|secrets\.|vars\.|z\.|yup\.|formdata|req\.|this\.|self\.|props\.)
allow-pair|(example\.(com|org|net)|@example|noreply@|your[- ]?email|name@)
allow-token|postgres(ql)?://postgres:postgres@
